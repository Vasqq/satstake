#!/bin/sh
# Blocks any commit whose staged changes contain a secret (LLR-DP-011).
# Enabled with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit unscanned changes." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --verbose --no-banner
